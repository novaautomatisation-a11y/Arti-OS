# ============================================================================
# Configuration Supabase pour ArtisanOS
# ============================================================================
#
# IMPORTANT: Ces mêmes variables doivent être configurées sur Vercel
# pour que le déploiement fonctionne correctement.
#
# Configuration Vercel:
#   1. Aller sur https://vercel.com/dashboard
#   2. Sélectionner votre projet → Settings → Environment Variables
#   3. Ajouter les variables ci-dessous avec leurs valeurs
#   4. Redéployer votre projet après avoir ajouté les variables
#
# Obtenir ces valeurs depuis: https://supabase.com/dashboard/project/_/settings/api
# ============================================================================

# URL de votre projet Supabase (doit commencer par https://)
# Exemple: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Clé anonyme (anon/public) de votre projet Supabase
# Exemple: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
